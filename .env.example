# Where the coach narrator proxy lives. Leave unset and explanations are simply
# off — every number the app shows is computed on the device and does not need it.
VITE_COACH_ENDPOINT=http://localhost:8787/api/coach

# Server side only. Never ship these to a browser; the proxy exists to hold them.
# ANTHROPIC_API_KEY=sk-ant-...

# Which model the proxy asks. Anthropic is the default and needs nothing here.
# COACH_PROVIDER=openai
# COACH_MODEL=the-model-or-azure-deployment-name
# COACH_API_KEY=...
# COACH_BASE_URL=https://api.openai.com/v1
# COACH_AUTH=api-key          # Azure OpenAI; omit for a bearer token
